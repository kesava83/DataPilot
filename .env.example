# Database Configuration (PostgreSQL)
# When ready, fill in your PostgreSQL details below or configure them dynamically in the UI
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
DB_SCHEMA=public

# Active database mode: 'postgres' or 'sample'
# Use 'sample' to explore with a pre-populated eCommerce database without configuring Postgres yet!
DB_MODE=sample

# AI / LLM Configuration
# Options: 'gemini', 'openai', 'ollama', 'mock'
AI_PROVIDER=gemini

# Google Gemini API Key (if using Gemini)
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# App Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
